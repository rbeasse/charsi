{
  "name": "charsi",
  "image": "mcr.microsoft.com/devcontainers/ruby:4",
  "mounts": [
    "source=${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached"
  ],
  "postCreateCommand": "bundle install",
  "customizations": {
    "vscode": {
      "extensions": [
        "shopify.ruby-lsp",
        "anthropic.claude-code"
      ]
    }
  }
}
